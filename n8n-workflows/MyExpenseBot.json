    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text.toLowerCase();\n\nconst parts = text.split(' ');\n\nlet amount, category, description;\n\nif (text.includes('spent') && text.includes('on')) {\n  amount = parseFloat(parts[1]);\n  category = parts[parts.indexOf('on') + 1];\n  description = text;\n} else if (!isNaN(parts[0])) {\n  amount = parseFloat(parts[0]);\n  category = parts[1] || 'general';\n  description = text;\n} else {\n  amount = null;\n  category = null;\n  description = text;\n}\n\nconst today = new Date().toLocaleDateString('en-IN');\nconst loggedAt = new Date().toISOString();\n\nreturn [{\n  json: {\n    date: today,\n    amount: amount,\n    category: category,\n    description: description,\n    loggedAt: loggedAt,\n    valid: amount !== null && !isNaN(amount)\n  }\n}];"
      },
