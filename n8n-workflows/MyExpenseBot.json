    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text;\nconst chatId = $input.first().json.message.chat.id;\n\n// Handle /connect command\nif (text.startsWith('/connect')) {\n  const email = text.split(' ')[1];\n  return [{\n    json: {\n      isConnect: true,\n      email: email,\n      chatId: String(chatId),\n      valid: false,\n      amount: null,\n      category: null\n    }\n  }];\n}\n\n// Normal expense parsing\nconst lowerText = text.toLowerCase();\nconst parts = lowerText.split(' ');\nlet amount, category, description;\n\nif (lowerText.includes('spent') && lowerText.includes('on')) {\n  amount = parseFloat(parts[1]);\n  category = parts[parts.indexOf('on') + 1];\n  description = lowerText;\n} else if (!isNaN(parts[0])) {\n  amount = parseFloat(parts[0]);\n  category = parts[1] || 'general';\n  description = lowerText;\n} else {\n  amount = null;\n  category = null;\n  description = lowerText;\n}\n\nconst today = new Date().toISOString().split('T')[0];\nconst loggedAt = new Date().toISOString();\n\nreturn [{\n  json: {\n    isConnect: false,\n    date: today,\n    amount: amount,\n    category: category,\n    description: description,\n    loggedAt: loggedAt,\n    valid: amount !== null && !isNaN(amount)\n  }\n}];"
      },
