    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst totals = {};\nlet grandTotal = 0;\n\nrows.forEach(row => {\n  const cat = row.json.Category || 'other';\n  const amt = parseFloat(row.json.Amount) || 0;\n  totals[cat] = (totals[cat] || 0) + amt;\n  grandTotal += amt;\n});\n\nlet summary = '📊 Weekly Summary\\n\\n';\nfor (const [cat, amt] of Object.entries(totals)) {\n  summary += `${cat}: ₹${amt.toFixed(0)}\\n`;\n}\nsummary += `\\nTotal: ₹${grandTotal.toFixed(0)}`;\n\nreturn [{ json: { summary } }];"
      },
